<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld minuta</string>
			<key>few</key>
			<string>%lld minuty</string>
			<key>many</key>
			<string>%lld minut</string>
			<key>other</key>
			<string>%lld minuty</string>
		</dict>
	</dict>
	<key>%lld hours</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld godzina</string>
			<key>few</key>
			<string>%lld godziny</string>
			<key>many</key>
			<string>%lld godzin</string>
			<key>other</key>
			<string>%lld godziny</string>
		</dict>
	</dict>
	<key>%lld hours after confirming</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld godzina po potwierdzeniu</string>
			<key>few</key>
			<string>%lld godziny po potwierdzeniu</string>
			<key>many</key>
			<string>%lld godzin po potwierdzeniu</string>
			<key>other</key>
			<string>%lld godziny po potwierdzeniu</string>
		</dict>
	</dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dzień</string>
			<key>few</key>
			<string>%lld dni</string>
			<key>many</key>
			<string>%lld dni</string>
			<key>other</key>
			<string>%lld dnia</string>
		</dict>
	</dict>
</dict>
</plist>
